{
  "name": "opencode-usage-plugin",
  "version": "0.1.0",
  "description": "OpenCode v2 CLI plugin that shows provider usage percentages in home and session footers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanvonderkrone/opencode-usage-plugin"
  },
  "exports": {
    "./tui": {
      "types": "./src/tui.tsx",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "tui.js",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun script/build.ts",
    "check": "tsc --noEmit",
    "usage": "bun src/usage.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.1.4",
    "@opentui/core": "^0.7.0",
    "@opentui/solid": "^0.7.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.4",
    "@opencode/theme": "2.1.4",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "solid-js": "1.9.12",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
